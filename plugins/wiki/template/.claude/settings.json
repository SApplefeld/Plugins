{
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read", "Glob", "Skill", "TodoWrite",
      "Edit(./wiki/**)",
      "Edit(./index.md)",
      "Edit(./log.md)",
      "Bash(pwsh -NoProfile -File ./.claude/kb-move.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/kb-move.ps1:*)",
      "Bash(pwsh -NoProfile -File ./.claude/kb-commit.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/kb-commit.ps1:*)",
      "Bash(pwsh -NoProfile -File ./.claude/kb-status.ps1:*)",
      "Bash(pwsh -NoProfile -File .claude/kb-status.ps1:*)"
    ],
    "deny": [
      "Grep",
      "Read(//**/.credentials.json)",
      "Read(//**/.claude.json)",
      "Read(//**/.git-credentials)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/*.pem)", "Read(//**/*.pfx)", "Read(//**/*.key)",
      "Read(//**/id_rsa)", "Read(//**/id_ed25519)",
      "Read(//**/.npmrc)", "Read(//**/.pypirc)",
      "Read(//**/.docker/config.json)", "Read(//**/.kube/config)",
      "Read(//**/.config/gh/**)", "Read(//**/GitHub CLI/**)",
      "Read(//**/.netrc)", "Read(//**/_netrc)",
      "Read(//**/.claude/*.json)",
      "Read(//**/UserSecrets/**)",
      "Read(//**/appsettings*.json)",
      "Edit(./sources/**)",
      "Edit(./inbox/**)", "Read(./inbox/**)",
      "Edit(./.git/**)",
      "Edit(./.claude/**)",
      "Edit(./wiki/**/CLAUDE.md)",
      "Edit(./wiki/**/CLAUDE.local.md)",
      "Edit(./wiki/**/.claude/**)",
      "Edit(./wiki/**/.mcp.json)",
      "Bash(git:*)",
      "Bash(mv:*)", "Bash(rm:*)", "Bash(cp:*)",
      "Bash(curl:*)", "Bash(wget:*)",
      "Bash(ls:*)"
    ]
  }
}
